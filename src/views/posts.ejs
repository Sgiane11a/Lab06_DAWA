<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Posts</title>
  <link href="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/css/materialize.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
</head>
<body class="grey lighten-4">

  <nav>
    <div class="nav-wrapper teal">
      <a href="/" class="brand-logo center">Social Media</a>
    </div>
  </nav>

  <div class="container">
    <h4 class="center-align">Lista de Posts</h4>

    <a href="/posts/new" class="btn waves-effect waves-light teal">+ Nuevo Post</a>

    <div class="row" style="margin-top: 20px;">
      <% posts.forEach(post => { %>
        <div class="col s12 m6 l4">
          <div class="card">
            <div class="card-image">
              <img src="<%= post.imageUrl || 'https://via.placeholder.com/300' %>" alt="Imagen del post">
            </div>
            <div class="card-content">
              <span class="card-title"><%= post.title %></span>
              <p><%= post.content %></p>
              <p><strong>Autor:</strong> <%= post.user ? post.user.name : "Anónimo" %></p>
              <% if (post.hashtags && post.hashtags.length) { %>
                <p><strong>Hashtags:</strong></p>
                <% post.hashtags.forEach(tag => { %>
                  <span class="chip">#<%= tag %></span>
                <% }) %>
              <% } %>
            </div>
            <div class="card-action">
              <a href="/posts/<%= post._id %>/edit" class="btn-flat"><i class="material-icons teal-text">edit</i></a>
              <form action="/posts/<%= post._id %>?_method=DELETE" method="POST" style="display:inline;">
                <button type="submit" class="btn-flat"><i class="material-icons red-text">delete</i></button>
              </form>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
</body>
</html>
